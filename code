subroutine transposta2 (m_in, m_out)
real m_in(2,2), m_out(2,2)
integer i,j
    do i= 1,2
do j= 1,2
m_out(i,j) = m_in(j,i)
end do
    end do

end

subroutine transposta (m_in,m_out)
real m_in(4,4), m_out(4,4)
integer i,j
    do i = 1,4
do j = 1,4
m_out(i,j) = m_in(j,i)
end do
    end do
end

subroutine tensores (a,b,c)
real a(2,2), b(2,2), c(4,4)

c(1,1) = a(1,1)*b(1,1)
c(1,2) = a(1,1)*b(1,2)
c(1,3) = a(1,2)*b(1,1)
c(1,4) = a(1,2)*b(1,2)

c(2,1) = a(1,1)*b(2,1)
c(2,2) = a(1,1)*b(2,2)
c(2,3) = a(1,2)*b(2,1)
c(2,4) = a(1,2)*b(2,2)

c(3,1) = a(2,1)*b(1,1)
c(3,2) = a(2,1)*b(1,2)
c(3,3) = a(2,2)*b(1,1)
c(3,4) = a(2,2)*b(1,2)

c(4,1) = a(2,1)*b(2,1)
c(4,2) = a(2,1)*b(2,2)
c(4,3) = a(2,2)*b(2,1)
c(4,4) = a(2,2)*b(2,2)

end
